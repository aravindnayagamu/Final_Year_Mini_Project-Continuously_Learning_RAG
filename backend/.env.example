POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=continual_rag
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/continual_rag
SQLITE_DB_URL=sqlite:///app/vector_db/chroma.sqlite3
REDIS_URL=rediss://default:your_upstash_redis_token@your_host.upstash.io:6379

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

APP_DIR=app

FETCH_INTERVAL_MINUTES=20

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

USE_TF=0
TRANSFORMERS_NO_TF=1
USE_TORCH=1
TF_ENABLE_ONEDNN_OPTS=0
